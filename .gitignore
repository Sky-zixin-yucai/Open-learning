# ============================================================
# Open-learning .gitignore
# ============================================================

# ----- Python -----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
pip-log.txt
pip-delete-this-directory.txt

# ----- 虚拟环境 -----
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# ----- 测试与覆盖率 -----
.coverage
.coverage.*
htmlcov/
.pytest_cache/
.tox/
.nox/
coverage.xml
*.cover
*.py,cover
.hypothesis/

# ----- 打包构建 -----
*.spec
build_windows/
build_linux/
build_macos/
*.exe
*.app
*.dmg
*.deb
*.rpm

# ----- IDE / 编辑器 -----
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/
*.sublime-project
*.sublime-workspace

# ----- 系统文件 -----
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ----- 日志 -----
*.log
logs/
*.log.*

# ----- 临时/缓存文件 -----
*.tmp
*.temp
*.bak
*.cache
*.old
*.orig
*.rej
.tmp/
temp/
.cache/

# ----- 环境变量 / 密钥 -----
.env
.env.local
.env.*.local
*.pem
*.key
*.crt
*.p12
secrets.yaml
config.local.yaml

# ----- 数据库 -----
*.db
*.sqlite
*.sqlite3
*.db-journal

# ----- 模型与大文件（按需取消注释）-----
# 下载的MMD/Live2D模型文件夹
# orb_skins/downloaded-*/
# assets/models/*.pmx
# assets/models/*.vrm
# assets/models/*.zip

# ----- 静态资源缓存 -----
# static/cache/
# static/uploads/
# static/orb_skins/downloaded-*/

# ----- 截图与导出 -----
screenshots/
exports/
*.png
!assets/**/*.png
!static/**/*.png

# ----- Node（如果有前端构建）-----
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
yarn.lock
.pnpm-store/

# ----- 其他 -----
*.pid
*.seed
*.pid.lock
.replit
.vercel
.netlify